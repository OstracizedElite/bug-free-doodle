# Copy to .env and fill in only the services you have approved for use.
# .env is git-ignored. Never commit real credentials.

# --- Market data providers (all optional; synthetic mode needs none) ---
TWELVEDATA_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
MASSIVE_API_KEY=

# --- Optional LLM reasoning (disabled by default in config) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# Path to an alternative YAML config layered over config/default.yaml
# PIT_CONFIG=config/local.yaml
# Database location (default: var/pit.db)
# PIT_DATABASE_PATH=var/pit.db
# Log level: DEBUG, INFO, WARNING, ERROR
# PIT_LOG_LEVEL=INFO
